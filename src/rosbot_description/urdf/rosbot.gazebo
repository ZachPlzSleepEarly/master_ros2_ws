<?xml version="1.0"?>
<robot name="rosbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 定义xacro变量 -->
  <xacro:property name="body_color" value="Gazebo/Silver" />
  <!-- xacro:property 定义一个变量 
   使用方式：${body_color} Gazebo/Silver 是 Gazebo 内置材质 
  -->


  <gazebo reference="base_link">
    <!--
gazebo reference
给指定 link 添加 Gazebo 物理属性
-->

    <material>${body_color}</material>
    <!-- Gazebo渲染材质 -->

    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <!--
  摩擦系数
  mu1: 主方向摩擦
  mu2: 次方向摩擦
  -->

    <self_collide>true</self_collide>
    <!-- link是否允许自碰撞 -->

    <gravity>true</gravity>
    <!-- 是否受重力 -->
  </gazebo>


  <gazebo reference="right_wheel_1">

    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>

    <self_collide>true</self_collide>

  </gazebo>


  <gazebo reference="left_wheel_1">

    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>

    <self_collide>true</self_collide>

  </gazebo>


  <gazebo reference="lidar_1">

    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>

    <self_collide>true</self_collide>

  </gazebo>


  <gazebo>
    <!-- 这里是 Gazebo **系统插件** 控制机器人行为 -->


    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>
      <!-- Gazebo渲染引擎 -->

    </plugin>


    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <topic>/joint_states</topic>
      <!-- 发布 joint state 到 ROS -->

    </plugin>


    <plugin filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- 差速驱动插件 根据 cmd_vel 控制轮子 -->

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.2</wheel_separation>
      <!-- 两轮间距 -->

      <wheel_radius>0.05</wheel_radius>
      <!-- 轮子半径 -->

      <odom_publish_frequency>30</odom_publish_frequency>
      <!-- odom发布频率 -->

      <topic>/cmd_vel</topic>
      <!-- 速度控制话题 -->

      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <!-- odom frame -->

      <odom_topic>odom</odom_topic>
      <!-- odom话题 -->

      <child_frame_id>base_footprint</child_frame_id>
      <!-- 机器人base frame -->

    </plugin>

  </gazebo>


  <gazebo reference="lidar_1">
    <!-- 给 lidar link 添加 Gazebo 传感器 -->

    <sensor name='gpu_lidar' type='gpu_lidar'>
      <!-- GPU激光雷达 -->

      <pose>0 0 0 0 0 0</pose>

      <topic>scan</topic>
      <!-- ROS2 LaserScan topic -->

      <gz_frame_id>lidar_1</gz_frame_id>
      <!-- TF frame -->

      <update_rate>10</update_rate>
      <!-- 扫描频率 -->


      <lidar>

        <scan>

          <horizontal>

            <samples>640</samples>
            <!-- 激光束数量 -->

            <resolution>1</resolution>

            <min_angle>0</min_angle>
            <max_angle>6.280000</max_angle>
            <!-- 360°扫描 -->

          </horizontal>


          <vertical>

            <samples>1</samples>
            <!-- 单层激光 -->

            <resolution>1</resolution>

            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>

          </vertical>

        </scan>


        <range>

          <min>0.08</min>
          <!-- 最小探测距离 -->

          <max>10.0</max>
          <!-- 最大探测距离 -->

          <resolution>0.01</resolution>

        </range>

      </lidar>


      <visualize>true</visualize>
      <!-- Gazebo显示激光 -->

    </sensor>

  </gazebo>


</robot>